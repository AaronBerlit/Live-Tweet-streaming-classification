# ---- Kaggle (ingest/download.py) -------------------------------------------
# Create a token at https://www.kaggle.com/settings -> API -> Create New Token.
# Accept the Sentiment140 dataset terms before the first download.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- storage ----------------------------------------------------------------
# 'hdfs' uses the containerised namenode; 'local' is the PRD §5.2 safety valve.
STORAGE_BACKEND=hdfs
HDFS_URI=hdfs://localhost:9000
LOCAL_DATA_ROOT=

# ---- services ---------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
KAFKA_BOOTSTRAP=localhost:9092

# ---- spark (sized for 16 GB / local[2], PRD §0 rule 6) ----------------------
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=4g

# ---- app --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DISPLAY_TIMEZONE=Asia/Kolkata
