{
  "builds": [
    { "src": "web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    {
      "src": "hosted/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**", "pipeline/**", "storage/**"] }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "hosted/index.py" },
    { "src": "/ws/(.*)", "status": 404 },
    { "src": "/assets/(.*)", "dest": "/web/assets/$1" },
    { "src": "/(.*)", "dest": "/web/index.html" }
  ],
  "regions": ["bom1"],
  "build": { "env": { "VITE_HOSTED_SNAPSHOT": "1" } }
}
